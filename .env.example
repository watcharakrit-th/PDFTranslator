# pdftr settings (copy to .env). Read by src/pdftr/settings.py.
PDFTR_DATABASE_URL=postgresql://pdftr:pdftr@127.0.0.1:5433/pdftr

# GPU safety: GPU work runs in small batches; between batches the run pauses
# while the GPU is at or above PAUSE_AT_C and resumes at RESUME_AT_C.
PDFTR_GPU_DEVICE=cuda
PDFTR_GPU_PAUSE_AT_C=75
PDFTR_GPU_RESUME_AT_C=65
PDFTR_GPU_COOLDOWN_S=2
PDFTR_DOCLING_BATCH_PAGES=5
