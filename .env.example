# pdftr settings (copy to .env). Read by src/pdftr/settings.py.
PDFTR_DATABASE_URL=postgresql://pdftr:pdftr@127.0.0.1:5433/pdftr

# GPU safety. Limits are the GPU *hot spot* (its hottest sensor, as HWiNFO/GPU-Z
# show it), which runs about 25 C above the core temperature under load.
# No new GPU work at or above PAUSE_AT_C until it is back at RESUME_AT_C; a
# translation request is stopped the moment it reaches ABORT_AT_C.
PDFTR_GPU_DEVICE=cuda
PDFTR_GPU_PAUSE_AT_C=75
PDFTR_GPU_RESUME_AT_C=65
PDFTR_GPU_ABORT_AT_C=90
PDFTR_GPU_REST_RATIO=1.0
PDFTR_GPU_COOLDOWN_S=2
# Refuse long GPU jobs while the card's power limit is above this many watts
# (0 = don't check). The limit resets after a reboot; 150 suits the RTX 2070 SUPER.
PDFTR_GPU_MAX_POWER_W=0
PDFTR_DOCLING_BATCH_PAGES=5
